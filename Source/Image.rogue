library Vimage
uses Graphics

class Image
  PROPERTIES
    file        : File?
    bitmap      : Bitmap
    name        : String
    zoom        : Real
    camera      = XY(0.5,0.5)
    is_modified : Logical
    error       : String

    cached_text_canvas    : TextCanvas
    cached_inline_bitmap  : Bitmap
    cached_inline_cell_size : XY
    cached_cell_units       : XY
    cached_cell_width_px    : Int
    cached_bitmap_size    : XY
    og_bitmap_size        : XY
    cached_view_center    : XY
    cached_display_bounds : Box

  METHODS
    method init( bitmap, name=null )
      is_modified = true

      if (bitmap.width == 0 or bitmap.height == 0)
        error = "Invalid zero-size bitmap"
        bitmap = Bitmap(1,1)
      endIf

    method init( bitmap, file )
      if (file) name = file.value.filepath

      if (bitmap.width == 0 or bitmap.height == 0)
        error = "Invalid zero-size bitmap"
        bitmap = Bitmap(1,1)
      endIf

    method init( file )
      name = file.value.filepath

    method bitmap->Bitmap
      if (@bitmap) return @bitmap

      if (file and file.value.exists)
        bitmap = Bitmap.load( file.value )
        if (not @bitmap)
          error = "Unsupported file type or corrupted file: " + file
          bitmap = Bitmap(1,1)
        endIf
      else
        bitmap = Bitmap(16,16)
        is_modified = true
      endIf

      forEach (item in ImageList)
        if (item->(as ImageListItem).image is this)
          item->(as ImageListItem).request_redraw
          if (ImageList.selected and this is ImageList.selected.image)
            ImageView.mark_modified
          endIf
          escapeForEach
        endIf
      endForEach

      return @bitmap

    method init( info:Variant )
      bitmap = info//bitmap.to<<Bitmap>>
      name = which{ info//name:info//name->String || null }
      zoom = info//zoom
      camera = XY( info//camera//x->Real, info//camera//y->Real )
      error = which{ info//error:info//error->String || null }
      is_modified = info//is_modified

      if (info//filepath)
        file = File(info//filepath->String)
        if (not file.value.exists) is_modified = true
      endIf

      cached_text_canvas = null
      cached_inline_bitmap = null

    method cloned_bitmap->Bitmap
      # Editing commands operate on copies of bitmap objects for undo chain purposes.
      bitmap .= cloned
      is_modified = true
      return bitmap

    method compact_name->String
      local result = String()
      result.print( which{error:'!' || is_modified:'*' || ' '} )
      if (name)
        result.print File(name).filename.before_last('.')
        if (not error) result.print ' '
      endIf
      if (not error and @bitmap)
        result.print '['
        result.print bitmap.width
        result.print 'x'
        result.print bitmap.height
        result.print ']'
      endIf
      return result


    method set_is_modified( @is_modified )
      if (is_modified)
        forEach (item in ImageList)
          if (item->(as ImageListItem).image is this)
            item->(as ImageListItem).request_redraw
            if (ImageList.selected and this is ImageList.selected.image)
              ImageView.mark_modified
            endIf
            escapeForEach
          endIf
        endForEach
      endIf

    method size->XY
      return bitmap.size

    method inline_bitmap( bitmap_size:XY, display_bounds:Box, cell_units:XY, cell_width_px:Int )->(bitmap:Bitmap,cell_size:XY)
      # Returns the visible portion of this image at the current zoom and camera
      # position, resized for display as an iTerm2 inline bitmap, along with the
      # size in console cells that it should occupy. 'bitmap_size' is the size of
      # the fully-zoomed image in image-pixel units, where one console cell is
      # 'cell_units' (e.g. 1x2). The result is padded so that it exactly fills
      # the returned cell region.
      contingent
        necessary (not is_modified)
        necessary (cached_inline_bitmap)
        necessary (bitmap_size == cached_bitmap_size)
        necessary (bitmap.size == og_bitmap_size)
        necessary (display_bounds == cached_display_bounds)
        necessary (camera == cached_view_center)
        necessary (cell_units == cached_cell_units)
        necessary (cell_width_px == cached_cell_width_px)
        return (cached_inline_bitmap, cached_inline_cell_size)
      endContingent

      og_bitmap_size = bitmap.size
      cached_bitmap_size = bitmap_size
      cached_display_bounds = display_bounds
      cached_view_center = camera
      cached_cell_units = cell_units
      cached_cell_width_px = cell_width_px
      cached_text_canvas = null

      local (piece,target_size) = _view_piece( bitmap_size, display_bounds, cell_units )

      # Cells occupied, rounding the (possibly fractional) height up
      local cell_size = XY( target_size.x, (target_size.y / cell_units.y).ceiling ).clamped_low( XY(1,1) )
      cell_size .= clamped_high( display_bounds.size )

      # One cell is cell_width_px wide and, keeping true aspect, cell_width_px*aspect tall
      local px_size = (cell_size * XY(cell_width_px, cell_width_px*cell_units.y))->XY.ceiling.clamped_low( XY(1,1) )
      local piece_px_size = (target_size * cell_width_px)->XY.clamped_low(XY(1,1)).clamped_high( px_size )

      piece.resize( piece_px_size )
      if (Vimage.hard_alpha) _apply_hard_alpha( piece )

      # Composite onto the same background the text-based view uses, padded
      # to fill the full cell region.
      local composite = Bitmap( px_size, Color(0xFF444444) )
      piece.blit( composite, XY.zero, BitmapBlitFn.ALPHA )

      cached_inline_bitmap = composite
      cached_inline_cell_size = cell_size
      return (cached_inline_bitmap, cached_inline_cell_size)

    method text_canvas( bitmap_size:XY, display_bounds:Box )->TextCanvas
      contingent
        necessary (not is_modified)
        necessary (cached_text_canvas)
        necessary (bitmap_size == cached_bitmap_size)
        necessary (bitmap.size == og_bitmap_size)
        necessary (display_bounds == cached_display_bounds)
        necessary (camera == cached_view_center)
        return cached_text_canvas
      endContingent

      og_bitmap_size = bitmap.size
      cached_bitmap_size = bitmap_size
      cached_display_bounds = display_bounds
      cached_view_center = camera
      cached_inline_bitmap = null

      local (piece,target_size) = _view_piece( bitmap_size, display_bounds, XY(1,2) )
      piece.resize( target_size )
      if (Vimage.hard_alpha) _apply_hard_alpha( piece )

      cached_text_canvas = piece->TextCanvas( &dither, &bg8=CharacterStyle.BG_DARK_GRAY, &bg24=Color(0xFF444444) )
      return cached_text_canvas

    method _view_piece( bitmap_size:XY, display_bounds:Box, cell_units:XY )->(piece:Bitmap,target_size:XY)
      # Crops out the portion of the bitmap that is visible in 'display_bounds' at
      # the current zoom & camera. Returns a copy of that portion along with the
      # size (in image-pixel units, where one console cell is 'cell_units') it
      # should be displayed at.
      local canvas_size = bitmap_size / cell_units
      if (cell_units.y == 2 and bitmap_size.y->Int & 1)
        canvas_size += XY(0,1)
      endIf

      local canvas_bounds = Box( (display_bounds.size/2-(canvas_size*camera)).clamped_high(XY.zero), canvas_size )
      canvas_bounds .= clamped( Box(display_bounds.size) )
      local bitmap_bounds = canvas_bounds * cell_units
      local piece_size = (display_bounds.size * cell_units / zoom)->XY.clamped_high( bitmap.size )
      if (cell_units.y == 2 and (piece_size.y * zoom)->Int & 1)
        local new_piece_size = ((piece_size * zoom) + XY(0,1)) / zoom
        local piece_bounds = Box( -bitmap_bounds.position/zoom, new_piece_size )
        if local intersection = piece_bounds & Box(bitmap.size)
          if intersection == piece_bounds
            piece_size = new_piece_size
          endIf
        endIf
      endIf

      local origin = -bitmap_bounds.position/zoom
      origin .= clamped_low( XY.zero )
      origin .= clamped_high( bitmap.size - piece_size )
      local piece = Bitmap( bitmap, Box(origin,piece_size) )
      local target_size = (piece_size*zoom)->XY.clamped_low(XY(1,1))

      return (piece, target_size)

    method _apply_hard_alpha( piece:Bitmap )
      local n = piece.pixels.count
      native @|RogueInt32* data  = $piece->pixels->as_int32s - 1;
              |
              |while (--$n >= 0)
              |{
              |  RogueInt32 argb = *(++data);
              |  RogueInt32 a;
              |  if ((a=(argb & 0xFF000000)) && a != 0xFF000000)
              |  {
              |    RogueInt32 g = ((argb>>8) & 255);
              |    RogueInt32 v = ((((argb>>16)&255) + g + (argb&255)) / 6) + 128;
              |    *data = (argb & 0xFFFF00FF) | 0xFF000000 | ((g & ~1) << 7) | (v<<16) | v;
              |  }
              |}

    method to->String
      if (@bitmap)
        if (name)
          if (error) return name
          return "$$ [$x$]"(which{is_modified:"*"||""},name,bitmap.width,bitmap.height)
        elseIf (is_modified)
          return "*[$x$]"(bitmap.width,bitmap.height)
        else
          return "[$x$]"(bitmap.width,bitmap.height)
        endIf
      else
        if (name)
          if (error) return name
          return "$$"(which{is_modified:"*"||""},name)
        elseIf (is_modified)
          return "*"
        else
          return "?"
        endIf
      endIf

    method to->Variant
      return ...
      @{
        filepath:which{file:file.value.filepath||null},
        bitmap:Variant(@bitmap),
        name,
        zoom,
        camera:{x:camera.x,y:camera.y},
        error,
        is_modified
      }

    method update_bitmap( @bitmap )
      is_modified = true
endClass

