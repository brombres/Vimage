library Vimage
uses Console/ANSIBitmap
uses UI

class ImageView : Component [singleton]
  DEFINITIONS
    # Resolution of iTerm2 inline images: bitmap pixels per console cell width.
    # iTerm2 scales the bitmap to the cell region it occupies, so this trades
    # sharpness for bytes sent through the terminal on each redraw of the image.
    INLINE_CELL_WIDTH_PX = 8

  PROPERTIES
    image            : Image
    canvas           : TextCanvas
    last_display_bounds : Box

    # iTerm2 inline image support
    inline_bitmap    : Bitmap     # Visible portion of the image, composited & sized for display
    inline_cell_size : XY         # Cells occupied by inline_bitmap
    inline_bounds    : Box?       # Console cell region of the currently-displayed inline image
    inline_data      : Byte[]     # Cached iTerm2 escape sequence for inline_bitmap
    inline_pending   : Logical    # inline_data must be (re)sent after the next canvas display
    scale_to_fit     = true
    min_zoom         : Real
    max_zoom         : Real
    default_zoom     : Real
    is_modified      : Logical
    visible_bounds   : Box
    camera_bounds_tl : XY
    camera_bounds_br : XY

  METHODS
    method init

    method on_draw [override]
      localize display_bounds

      local bg = CharacterStyle( CharacterStyle.BG_DARK_GRAY ).bg( Color(0xFF444444) )
      ConsoleUICanvas.fill( display_bounds->Box, StyledCharacter(' ',bg) )

      localize cell_units

      if (display_bounds != last_display_bounds)
        last_display_bounds = display_bounds
        is_modified = true
      endIf

      if (image)
        if (is_modified)
          is_modified = false
          visible_bounds = Box( image.bitmap.size )
          local new_size : XY
          if (min_zoom)
            new_size = (image.bitmap.size->XY * image.zoom)
          else
            local scale = ((display_bounds.size->XY*cell_units) / image.bitmap.size->XY).min
            new_size = (image.bitmap.size->XY * scale)
            default_zoom = (new_size.x->Real / image.bitmap.width)
            min_zoom = default_zoom.or_smaller( 1.0 )
            max_zoom = which{ default_zoom>1.0:default_zoom || 1.0 }
            if (image.zoom)
              if (image.zoom < min_zoom)
                image.zoom = min_zoom
                image.camera = XY(0.5,0.5)
              else
                new_size = (image.bitmap.size->XY * image.zoom)
              endIf
            else
              image.zoom = default_zoom
            endIf
          endIf

          local sz = (display_bounds.size * cell_units)->XY
          sz = (sz / image.zoom).clamped_high( image.size ) / image.size
          camera_bounds_tl = (sz / 2) - cell_units/image.size
          camera_bounds_br = (XY(1,1) - sz/2)
          image.camera .= clamped( camera_bounds_tl, camera_bounds_br )

          TitleBar.zoom = image.zoom
          if (Vimage.using_iterm2)
            local (bitmap,cell_size) = image.inline_bitmap( new_size, display_bounds, cell_units, INLINE_CELL_WIDTH_PX )
            if (bitmap is not inline_bitmap)
              inline_bitmap = bitmap
              inline_cell_size = cell_size
              inline_data = null
              inline_pending = true
            endIf
          else
            canvas = image.text_canvas( new_size, display_bounds )
          endIf
        endIf

      endIf

    method on_draw_over [override]
      if (Vimage.using_iterm2)
        if (image and inline_bitmap)
          local sz = inline_cell_size
          local pos = Box( display_bounds.center - (sz/2), sz ).clamped( display_bounds ).top_left
          local new_bounds = Box( pos, sz )
          if (inline_pending or not inline_bounds or inline_bounds.value != new_bounds)
            # The image is new or has moved. Invalidate the cells it used to
            # cover and the whole view so that ConsoleUICanvas.display rewrites
            # them (erasing any stale image fragments) before the new image is
            # drawn on top.
            if (inline_bounds) ConsoleUICanvas.invalidate( inline_bounds.value )
            ConsoleUICanvas.invalidate( display_bounds->Box )
            inline_bounds = new_bounds
            inline_pending = true
          endIf
        elseIf (inline_bounds)
          # No image to display; wipe the old one
          ConsoleUICanvas.invalidate( inline_bounds.value )
          inline_bounds = null
          inline_pending = false
        endIf
      elseIf (image)
        temporarily ConsoleUICanvas.clip = display_bounds->Box
          local sz = canvas.size
          local pos = Box( display_bounds.center - (sz/2), sz ).clamped( display_bounds ).top_left
          ConsoleUICanvas.draw( canvas, pos )
        endTemporarily
      endIf

    method cell_aspect->Real
      # Height of a console character cell relative to its width. Character
      # block graphics assume 2:1; iTerm2 inline images use the actual cell size
      # if the terminal reported it.
      if (Vimage.using_iterm2 and Vimage.iterm2_cell_size)
        local size = Vimage.iterm2_cell_size.value
        if (size.x > 0 and size.y > 0) return size.y / size.x
      endIf
      return 2.0

    method cell_units->XY
      # The size of one console cell in image-pixel units at 1:1 zoom.
      return XY( 1, cell_aspect )

    method check_inline_overdraw
      # Called after every component has drawn to ConsoleUICanvas but before the
      # canvas is displayed. If any cell under the inline image is about to be
      # rewritten (which erases that part of the image), schedule a redraw of
      # the image.
      if (inline_pending or not inline_bounds) return

      local bounds = inline_bounds.value & Box( ConsoleUICanvas.width, ConsoleUICanvas.height )
      if (not bounds) return

      local cui = ConsoleUICanvas
      local width = cui.width
      forEach (j in bounds.value.y1->Int ..< bounds.value.y2->Int)
        local index = j * width + bounds.value.x1->Int
        loop (bounds.value.width->Int)
          if (cui.buffer[index] != cui.displayed[index])
            inline_pending = true
            return
          endIf
          ++index
        endLoop
      endForEach

    method draw_inline_image
      # Called after ConsoleUICanvas has been displayed. Sends the inline image
      # to iTerm2 if necessary. Console cursor is left at its original position.
      if (not Vimage.using_iterm2 or not inline_pending) return
      inline_pending = false
      if (not inline_bitmap or not inline_bounds) return

      if (not inline_data) inline_data = inline_image_data( inline_bitmap, inline_cell_size )

      local pos = inline_bounds.value.position
      Console.flush
      Console.set_cursor( pos )
      _write( inline_data )
      Console.set_cursor( 0, VimageUI.bounds.y2 )

    method inline_image_data( bitmap:Bitmap, cell_size:XY )->Byte[]
      # Builds an iTerm2 Inline Image escape sequence:
      #   ESC ] 1337 ; File = key=value ; ... : <base64 data> BEL
      # https://iterm2.com/documentation-images.html
      # The bitmap has already been sized and padded to exactly fill its cell
      # region (see Image.inline_bitmap), so preserveAspectRatio=0 stretches it
      # to the region with no letterboxing.
      local bmp = bitmap.to_png_bytes

      local header = "\e]1337;File=inline=1;preserveAspectRatio=0;size=$;width=$;height=$:" ...
                     (bmp.count, cell_size.x->Int, cell_size.y->Int)

      local base64_count = ((bmp.count + 2) / 3) * 4
      local result = Byte[]( header.byte_count + base64_count + 1 )
      result.add( header.to_utf8 )

      local out_offset = result.count
      result.expand_to_count( out_offset + base64_count )
      local src_count = bmp.count
      native @|static const char table[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
              |const unsigned char* src = (const unsigned char*) $bmp->as_bytes;
              |const unsigned char* src_limit = src + $src_count;
              |unsigned char* dest = (unsigned char*) $result->as_bytes + $out_offset;
              |while (src + 3 <= src_limit)
              |{
              |  unsigned int triple = (src[0] << 16) | (src[1] << 8) | src[2];
              |  src += 3;
              |  *(dest++) = table[ (triple >> 18) & 63 ];
              |  *(dest++) = table[ (triple >> 12) & 63 ];
              |  *(dest++) = table[ (triple >> 6) & 63 ];
              |  *(dest++) = table[ triple & 63 ];
              |}
              |int remaining = (int)(src_limit - src);
              |if (remaining == 1)
              |{
              |  unsigned int triple = (src[0] << 16);
              |  *(dest++) = table[ (triple >> 18) & 63 ];
              |  *(dest++) = table[ (triple >> 12) & 63 ];
              |  *(dest++) = '=';
              |  *(dest++) = '=';
              |}
              |else if (remaining == 2)
              |{
              |  unsigned int triple = (src[0] << 16) | (src[1] << 8);
              |  *(dest++) = table[ (triple >> 18) & 63 ];
              |  *(dest++) = table[ (triple >> 12) & 63 ];
              |  *(dest++) = table[ (triple >> 6) & 63 ];
              |  *(dest++) = '=';
              |}

      result.add( 7 )  # BEL terminator
      return result

    method _write( bytes:Byte[] )
      # Writes raw bytes to stdout, bypassing the Console's character buffer.
      # Console's immediate mode leaves stdin (and therefore the shared terminal
      # file description) non-blocking, which makes large writes busy-spin, so
      # blocking mode is temporarily restored for the duration of the write.
      native @|const char* src = (const char*) $bytes->as_bytes;
              |%Ns%RogueInt remaining = $bytes->count;
              |#if defined(%NS%ROGUE_TARGET_WINDOWS)
              |  %Ns%Rogue_fwrite( src, remaining, STDOUT_FILENO );
              |#else
              |  int flags = fcntl( STDOUT_FILENO, F_GETFL );
              |  if (flags & O_NONBLOCK) fcntl( STDOUT_FILENO, F_SETFL, flags & ~O_NONBLOCK );
              |  while (remaining > 0)
              |  {
              |    ssize_t n = write( STDOUT_FILENO, src, (size_t)remaining );
              |    if (n > 0) { src += n; remaining -= n; }
              |    else if (n < 0 && errno != EINTR && errno != EAGAIN) break;
              |  }
              |  if (flags & O_NONBLOCK) fcntl( STDOUT_FILENO, F_SETFL, flags );
              |#endif

    method mark_modified
      if (not is_modified)
        is_modified = true
        request_redraw
      endIf

    method maximum_zoom
      if (image)
        if (image.zoom != max_zoom)
          image.zoom = max_zoom
          TitleBar.zoom = image.zoom
          mark_modified
        endIf
      endIf

    method reset_zoom
      if (image)
        if (image.zoom != default_zoom)
          image.zoom = default_zoom
          image.camera = XY(0.5,0.5)
          TitleBar.zoom = image.zoom
          mark_modified
        endIf
      endIf

    method scroll( delta:XY )
      delta *= cell_units
      if (image)
        if (image.zoom == default_zoom)
          image.camera = XY(0.5,0.5)
        elseIf (image.zoom)
          delta *= display_bounds.size / (image.bitmap.size * image.zoom)
          image.camera = (image.camera + delta).clamped( 0.0, 1.0 )
        endIf
        mark_modified
      endIf

    method show( new_image:Image )
      if (image and image.zoom == default_zoom) image.zoom = 0

      image = new_image
      min_zoom = 0
      default_zoom = 0
      scale_to_fit = true
      mark_modified

    method zoom_in
      if (image)
        if (image.zoom < max_zoom)
          image.zoom *= 2
          if (image.zoom >= max_zoom)
            image.zoom = max_zoom
          else
            local n = 0
            while (image.zoom < max_zoom)
              ++n
              image.zoom *= 2
            endWhile
            image.zoom = max_zoom
            loop (n) image.zoom /= 2
          endIf
        endIf
        TitleBar.zoom = image.zoom
        mark_modified
      endIf

    method zoom_out
      if (image)
        if (image.zoom > min_zoom)
          image.zoom /= 2
          if (image.zoom < min_zoom)
            image.zoom = min_zoom
            image.camera = XY(0.5,0.5)
          endIf
        endIf
        TitleBar.zoom = image.zoom
        mark_modified
      endIf
endClass
